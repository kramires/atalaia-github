# Copie este arquivo para .env e preencha as chaves.
#   cp .env.example .env

# ── Provedores de LLM (preencha ao menos uma chave) ──
# Default = provider "balanceado": OpenAI primário -> DeepSeek secundário.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Opcional — LLM local (Ollama); descomente se for usar.
# OLLAMA_BASE_URL=http://localhost:11434

# ── Ambiente ──
LOG_LEVEL=INFO
